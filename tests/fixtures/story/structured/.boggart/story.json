{
  "title": "The Test Autumn",
  "layout": "structured",
  "manuscript": { "glob": ["chapters/*.md"], "number": "^(%d+)", "prefer": ["revised", ""],
                  "exclude": ["*_recovered.md"], "done": ["revised"] },
  "characters": ["characters/*.md"],
  "canon": [ { "glob": "plot/*.md", "role": "plot" } ],
